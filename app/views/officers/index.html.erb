<% content_for :title, "Officers" %>

<div class="page-header">
  <h1>Officers</h1>
  <%= link_to "New Officer", new_officer_path, class: "btn btn-primary" %>
</div>

<div class="table-card" style="margin-bottom:16px;padding:16px 20px;">
  <%= form_with url: officers_path, method: :get, local: true, style: "display:flex;align-items:center;gap:12px;flex-wrap:wrap;" do |f| %>
    <%= f.text_field :badge_number, value: params[:badge_number], placeholder: "Badge #",
          style: "font-size:13px;padding:6px 10px;border:1px solid #D1D5DB;border-radius:6px;" %>
    <%= f.text_field :name, value: params[:name], placeholder: "Name",
          style: "font-size:13px;padding:6px 10px;border:1px solid #D1D5DB;border-radius:6px;" %>
    <%= f.select :rank,
          Officer::RANKS.map { |r| [r, r] },
          { selected: params[:rank], include_blank: "All Ranks" },
          class: "btn btn-secondary btn-sm", style: "font-weight:400;" %>
    <%= f.select :active,
          [["Active", "true"], ["Inactive", "false"]],
          { selected: params[:active], include_blank: "All Statuses" },
          class: "btn btn-secondary btn-sm", style: "font-weight:400;" %>
    <%= f.submit "Filter", class: "btn btn-primary btn-sm" %>
    <%= link_to "Clear", officers_path, class: "btn btn-secondary btn-sm" %>
  <% end %>
</div>

<div class="table-card">
  <table class="rms-table">
    <thead>
      <tr>
        <th>Badge #</th>
        <th>Name</th>
        <th>Rank</th>
        <th>Assignments</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if @officers.empty? %>
        <tr><td colspan="5"><div class="empty-state"><p><%= params.slice(:badge_number, :name, :rank, :active).values.any?(&:present?) ? "No officers match your filters." : "No officers on record." %></p></div></td></tr>
      <% else %>
        <% @officers.each do |officer| %>
          <tr>
            <td class="col-primary"><%= officer.badge_number %></td>
            <td><%= officer.last_name %>, <%= officer.first_name %></td>
            <td>
              <%
                badge = case officer.rank
                        when "Chief", "Deputy Chief" then "badge-purple"
                        when "Captain", "Commander"  then "badge-blue"
                        when "Detective"             then "badge-blue"
                        when "Sergeant", "Lieutenant" then "badge-yellow"
                        else "badge-gray"
                        end
              %>
              <span class="badge <%= badge %>"><%= officer.rank %></span>
            </td>
            <td><%= officer.assignments&.truncate(60) %></td>
            <td class="col-actions">
              <%= link_to "View", officer, class: "btn btn-secondary btn-sm" %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
