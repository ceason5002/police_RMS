<% content_for :title, "Officer" %>
<div class="page-header">
  <h1>Officer</h1>
  <div style="display:flex;gap:10px;">
    <%= link_to "Edit", edit_officer_path(@officer), class: "btn btn-secondary" %>
    <%= button_to "Delete", @officer, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Are you sure?" } } %>
  </div>
</div>
<%= render @officer %>
<%= link_to "← Back", officers_path, class: "btn btn-secondary", style: "margin-top: 16px;" %>
