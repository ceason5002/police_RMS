<%= form_with model: [:admin, vehicle], style: "display:flex;flex-direction:column;gap:16px;" do |f| %>
  <% if vehicle.errors.any? %>
    <div style="background:#FEE2E2;border:1px solid #FECACA;color:#991B1B;padding:12px 16px;border-radius:6px;font-size:13px;">
      <%= vehicle.errors.full_messages.join(" · ") %>
    </div>
  <% end %>

  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;">
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Unit Number *</label>
      <%= f.text_field :unit_number, placeholder: "e.g. Unit-101", style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;box-sizing:border-box;" %>
    </div>
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Status *</label>
      <%= f.select :status, FleetVehicle::STATUSES, {}, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;" %>
    </div>
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Year *</label>
      <%= f.number_field :year, placeholder: "2024", style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;" %>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;">
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Make *</label>
      <%= f.text_field :make, placeholder: "Ford", style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;box-sizing:border-box;" %>
    </div>
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Model *</label>
      <%= f.text_field :model, placeholder: "Explorer", style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;box-sizing:border-box;" %>
    </div>
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Color</label>
      <%= f.text_field :color, placeholder: "White", style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;box-sizing:border-box;" %>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">VIN</label>
      <%= f.text_field :vin, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;font-family:monospace;box-sizing:border-box;" %>
    </div>
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Current Mileage</label>
      <%= f.number_field :current_mileage, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;" %>
    </div>
  </div>

  <div>
    <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Notes</label>
    <%= f.text_area :notes, rows: 3, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;box-sizing:border-box;resize:vertical;" %>
  </div>

  <div style="display:flex;gap:10px;">
    <%= f.submit vehicle.persisted? ? "Update Vehicle" : "Add Vehicle", style: "background:#635BFF;color:#fff;border:none;padding:9px 20px;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;" %>
    <%= link_to "Cancel", admin_fleet_vehicles_path, style: "padding:9px 16px;font-size:13px;color:#64748B;" %>
  </div>
<% end %>
