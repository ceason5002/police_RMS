<%= form_with model: [:admin, complaint], style: "display:flex;flex-direction:column;gap:16px;" do |f| %>
  <% if complaint.errors.any? %>
    <div style="background:#FEE2E2;border:1px solid #FECACA;color:#991B1B;padding:12px 16px;border-radius:6px;font-size:13px;">
      <%= complaint.errors.full_messages.join(" · ") %>
    </div>
  <% end %>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Complaint Type *</label>
      <%= f.select :complaint_type, OfficerComplaint::COMPLAINT_TYPES, { include_blank: "Select type..." }, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;" %>
    </div>
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Status</label>
      <%= f.select :status, OfficerComplaint::STATUSES, {}, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;" %>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Complainant Name</label>
      <%= f.text_field :complainant_name, placeholder: "Leave blank if anonymous", style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;box-sizing:border-box;" %>
    </div>
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Contact (email or phone)</label>
      <%= f.text_field :complainant_contact, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;box-sizing:border-box;" %>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;">
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Officer Named</label>
      <%= f.collection_select :officer_id, @officers, :id, :full_name, { include_blank: "None / Unknown" }, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;" %>
    </div>
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Incident Date</label>
      <%= f.date_field :incident_date, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;" %>
    </div>
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Assigned Investigator</label>
      <%= f.text_field :assigned_investigator, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;box-sizing:border-box;" %>
    </div>
  </div>

  <div>
    <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Description *</label>
    <%= f.text_area :description, rows: 5, placeholder: "Detailed account of the complaint...", style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;box-sizing:border-box;resize:vertical;" %>
  </div>

  <div>
    <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Internal Notes <span style="font-weight:400;color:#94A3B8;">(not shared externally)</span></label>
    <%= f.text_area :internal_notes, rows: 3, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;box-sizing:border-box;resize:vertical;" %>
  </div>

  <div style="display:flex;gap:10px;">
    <%= f.submit complaint.persisted? ? "Update Complaint" : "Log Complaint", style: "background:#635BFF;color:#fff;border:none;padding:9px 20px;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;" %>
    <%= link_to "Cancel", admin_officer_complaints_path, style: "padding:9px 16px;font-size:13px;color:#64748B;" %>
  </div>
<% end %>
