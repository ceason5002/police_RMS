<% content_for :title, "Complaint ##{@complaint.id}" %>
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
  <div>
    <div style="font-size:12px;color:#64748B;margin-bottom:4px;"><%= link_to "Complaints", admin_officer_complaints_path, style: "color:#635BFF;" %> / #<%= @complaint.id %></div>
    <h1 style="font-size:20px;font-weight:700;color:#0F172A;margin:0;"><%= @complaint.complaint_type %></h1>
  </div>
  <%= link_to "Edit", edit_admin_officer_complaint_path(@complaint), style: "background:#635BFF;color:#fff;padding:8px 16px;border-radius:6px;text-decoration:none;font-size:13px;font-weight:600;" %>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
  <div style="display:flex;flex-direction:column;gap:16px;">
    <div style="background:#fff;border:1px solid #E2E8F0;border-radius:8px;padding:20px;">
      <div style="font-size:12px;font-weight:600;color:#94A3B8;text-transform:uppercase;margin-bottom:12px;">Complaint Details</div>
      <% [["Type", @complaint.complaint_type], ["Status", @complaint.status], ["Received", @complaint.received_at.strftime("%B %-d, %Y %H:%M")], ["Incident Date", @complaint.incident_date&.strftime("%B %-d, %Y") || "—"], ["Officer Named", @complaint.officer&.full_name || "—"], ["Investigator", @complaint.assigned_investigator.presence || "—"]].each do |label, val| %>
        <div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #F8FAFC;font-size:13px;">
          <span style="color:#64748B;"><%= label %></span>
          <span style="font-weight:500;"><%= val %></span>
        </div>
      <% end %>
    </div>

    <div style="background:#fff;border:1px solid #E2E8F0;border-radius:8px;padding:20px;">
      <div style="font-size:12px;font-weight:600;color:#94A3B8;text-transform:uppercase;margin-bottom:12px;">Complainant</div>
      <div style="font-size:13px;font-weight:500;margin-bottom:4px;"><%= @complaint.complainant_name.presence || "Anonymous" %></div>
      <div style="font-size:13px;color:#64748B;"><%= @complaint.complainant_contact.presence || "No contact info" %></div>
    </div>
  </div>

  <div style="display:flex;flex-direction:column;gap:16px;">
    <div style="background:#fff;border:1px solid #E2E8F0;border-radius:8px;padding:20px;">
      <div style="font-size:12px;font-weight:600;color:#94A3B8;text-transform:uppercase;margin-bottom:12px;">Description</div>
      <p style="font-size:13px;color:#374151;line-height:1.6;margin:0;"><%= @complaint.description %></p>
    </div>

    <% if @complaint.internal_notes.present? %>
      <div style="background:#FFFBEB;border:1px solid #FDE68A;border-radius:8px;padding:20px;">
        <div style="font-size:12px;font-weight:600;color:#92400E;text-transform:uppercase;margin-bottom:8px;">Internal Notes</div>
        <p style="font-size:13px;color:#374151;line-height:1.6;margin:0;"><%= @complaint.internal_notes %></p>
      </div>
    <% end %>
  </div>
</div>

<div style="margin-top:16px;">
  <%= button_to "Delete Complaint", admin_officer_complaint_path(@complaint), method: :delete, data: { turbo_confirm: "Permanently delete this complaint?" }, style: "background:#FEE2E2;color:#DC2626;border:1px solid #FECACA;padding:8px 14px;border-radius:6px;font-size:13px;cursor:pointer;" %>
</div>
