<%= form_with model: [:admin, training], style: "display:flex;flex-direction:column;gap:16px;" do |f| %>
  <% if training.errors.any? %>
    <div style="background:#FEE2E2;border:1px solid #FECACA;color:#991B1B;padding:12px 16px;border-radius:6px;font-size:13px;">
      <%= training.errors.full_messages.join(" · ") %>
    </div>
  <% end %>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Officer *</label>
      <%= f.collection_select :officer_id, @officers, :id, :full_name, { include_blank: "Select officer..." }, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;" %>
    </div>
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Training Type *</label>
      <%= f.select :training_type, OfficerTraining::TRAINING_TYPES, { include_blank: "Select type..." }, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;" %>
    </div>
  </div>

  <div>
    <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Title *</label>
    <%= f.text_field :title, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;box-sizing:border-box;" %>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;">
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Status *</label>
      <%= f.select :status, OfficerTraining::STATUSES, {}, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;" %>
    </div>
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Completed On</label>
      <%= f.date_field :completed_on, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;" %>
    </div>
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Expires On</label>
      <%= f.date_field :expires_on, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;" %>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Instructor</label>
      <%= f.text_field :instructor, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;box-sizing:border-box;" %>
    </div>
    <div>
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Hours</label>
      <%= f.number_field :hours, step: 0.5, min: 0, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;" %>
    </div>
  </div>

  <div>
    <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px;">Notes</label>
    <%= f.text_area :notes, rows: 3, style: "width:100%;border:1px solid #CBD5E1;border-radius:6px;padding:8px 10px;font-size:13px;box-sizing:border-box;resize:vertical;" %>
  </div>

  <div style="display:flex;gap:10px;">
    <%= f.submit training.persisted? ? "Update Record" : "Add Record", style: "background:#635BFF;color:#fff;border:none;padding:9px 20px;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;" %>
    <%= link_to "Cancel", admin_officer_trainings_path, style: "padding:9px 16px;font-size:13px;color:#64748B;" %>
  </div>
<% end %>
