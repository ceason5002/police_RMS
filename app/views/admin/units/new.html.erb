<div class="page-header">
  <h1>New Unit</h1>
  <%= link_to "Back", admin_units_path, class: "btn btn-secondary" %>
</div>

<div class="form-card">
  <%= form_with model: [:admin, unit], local: true do |f| %>
    <% if unit.errors.any? %>
      <div class="error-box">
        <strong><%= pluralize(unit.errors.count, "error") %> prohibited this unit from being saved:</strong>
        <ul>
          <% unit.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
      <div>
        <%= f.label :name %>
        <%= f.text_field :name, placeholder: "e.g. Homicide Division" %>
      </div>
      <div>
        <%= f.label :unit_type, "Type" %>
        <%= f.select :unit_type, Unit::TYPES.map { |t| [t, t] }, { include_blank: "Select Type" } %>
      </div>
    </div>

    <div style="margin-top:20px;">
      <%= f.label :description %>
      <%= f.text_area :description, rows: 4, placeholder: "Unit description, jurisdiction, responsibilities…" %>
    </div>

    <div style="margin-top:28px;display:flex;gap:10px;">
      <%= f.submit "Create Unit", class: "btn btn-primary" %>
      <%= link_to "Cancel", admin_units_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>