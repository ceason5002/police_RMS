<div class="page-header">
  <h1>Units</h1>
  <%= link_to "New Unit", new_admin_unit_path, class: "btn btn-primary" %>
</div>

<div class="table-card">
  <% if @units.any? %>
    <table class="rms-table">
      <thead>
        <tr>
          <th class="col-primary">Name</th>
          <th>Type</th>
          <th>Officers</th>
          <th class="col-actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @units.each do |unit| %>
          <tr>
            <td class="col-primary" style="font-weight:600;"><%= unit.name %></td>
            <td><span class="badge badge-blue"><%= unit.unit_type %></span></td>
            <td style="text-align:center;"><%= unit.officers.count %></td>
            <td class="col-actions">
              <%= link_to "View", admin_unit_path(unit), class: "btn btn-secondary btn-sm" %>
              <%= link_to "Edit", edit_admin_unit_path(unit), class: "btn btn-secondary btn-sm" %>
              <%= button_to "Delete", admin_unit_path(unit), method: :delete,
                    class: "btn btn-danger btn-sm",
                    data: { confirm: "Delete unit #{unit.name}? This cannot be undone." } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p style="color:#9CA3AF;text-align:center;padding:40px 0;">No units found. Create your first unit above.</p>
  <% end %>
</div>