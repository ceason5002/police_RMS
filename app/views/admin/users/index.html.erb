<div class="page-header">
  <h1>User Access Control</h1>
  <%= link_to "New User", new_admin_user_path, class: "btn btn-primary" %>
</div>

<div class="table-card">
  <% if @users.any? %>
    <table class="rms-table">
      <thead>
        <tr>
          <th class="col-primary">Email</th>
          <th>Role</th>
          <th>Linked Officer</th>
          <th>Active</th>
          <th class="col-actions">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td class="col-primary"><%= user.email %></td>
            <td>
              <%
                role_badge = case user.role
                             when "admin"          then "badge-purple"
                             when "detective"       then "badge-blue"
                             when "patrol_officer"  then "badge-gray"
                             else "badge-gray"
                             end
              %>
              <span class="badge <%= role_badge %>"><%= user.display_role %></span>
            </td>
            <td style="font-size:13px;">
              <% if user.officer %>
                <%= link_to user.officer.full_name, admin_officer_path(user.officer), style: "color:#635BFF;" %>
              <% else %>
                <span style="color:#9CA3AF;">—</span>
              <% end %>
            </td>
            <td>
              <% if user.active? %>
                <span class="badge badge-green">Yes</span>
              <% else %>
                <span class="badge badge-red">No</span>
              <% end %>
            </td>
            <td class="col-actions">
              <%= link_to "Edit", edit_admin_user_path(user), class: "btn btn-secondary btn-sm" %>
              <%= button_to user.active? ? "Deactivate" : "Activate",
                    toggle_active_admin_user_path(user),
                    method: :patch,
                    class: "btn btn-sm #{user.active? ? 'btn-secondary' : 'btn-primary'}" %>
              <%= button_to "Delete", admin_user_path(user), method: :delete,
                    class: "btn btn-danger btn-sm",
                    data: { confirm: "Delete user #{user.email}? This cannot be undone." } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p style="color:#9CA3AF;text-align:center;padding:40px 0;">No users found.</p>
  <% end %>
</div>