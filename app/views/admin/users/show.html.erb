<%
  role_badge = case @user.role
               when "admin"         then "badge-purple"
               when "detective"      then "badge-blue"
               when "patrol_officer" then "badge-gray"
               else "badge-gray"
               end
%>

<div class="page-header">
  <h1><%= @user.login_id %></h1>
  <div style="display:flex;gap:8px;">
    <%= link_to "Edit", edit_admin_user_path(@user), class: "btn btn-primary" %>
    <%= link_to "Back", admin_users_path, class: "btn btn-secondary" %>
  </div>
</div>

<div class="detail-card">
  <div class="detail-card-header">
    <h2>User Details</h2>
    <span class="badge <%= role_badge %>"><%= @user.display_role %></span>
  </div>
  <dl class="detail-grid">
    <div class="detail-field">
      <dt>ID</dt>
      <dd><%= @user.login_id %></dd>
    </div>
    <div class="detail-field">
      <dt>Role</dt>
      <dd><span class="badge <%= role_badge %>"><%= @user.display_role %></span></dd>
    </div>
    <div class="detail-field">
      <dt>Linked Officer</dt>
      <dd>
        <% if @user.officer %>
          <%= link_to @user.officer.full_name, admin_officer_path(@user.officer), style: "color:#635BFF;" %>
          <span style="color:#6B7280;font-size:13px;margin-left:6px;">(Badge #<%= @user.officer.badge_number %>)</span>
        <% else %>
          —
        <% end %>
      </dd>
    </div>
    <div class="detail-field">
      <dt>Active</dt>
      <dd>
        <% if @user.active? %>
          <span class="badge badge-green">Active</span>
        <% else %>
          <span class="badge badge-red">Inactive</span>
        <% end %>
      </dd>
    </div>
    <div class="detail-field">
      <dt>Member Since</dt>
      <dd><%= @user.created_at.strftime("%m/%d/%Y at %H:%M") %></dd>
    </div>
  </dl>
</div>