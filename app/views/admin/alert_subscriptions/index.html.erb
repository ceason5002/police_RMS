<% content_for :title, "Alert Subscriptions" %>
<div class="page-header"><h1>Crime Alert Subscriptions</h1></div>
<div class="table-card">
  <table class="rms-table">
    <thead><tr><th>Email</th><th>ZIP Code</th><th>Confirmed</th><th>Subscribed</th><th class="col-actions"></th></tr></thead>
    <tbody>
      <% @subscriptions.each do |sub| %>
        <tr>
          <td><%= sub.email %></td>
          <td><%= sub.zip_code %></td>
          <td><span class="badge <%= sub.confirmed ? 'badge-green' : 'badge-gray' %>"><%= sub.confirmed ? "Yes" : "Pending" %></span></td>
          <td style="font-size:12px;color:#8898AA;"><%= sub.created_at.strftime("%m/%d/%Y") %></td>
          <td class="col-actions">
            <%= button_to "Remove", admin_alert_subscription_path(sub), method: :delete, class: "btn btn-danger btn-sm", data: { turbo_confirm: "Remove subscription?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
