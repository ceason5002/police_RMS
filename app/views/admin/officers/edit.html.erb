<div class="page-header">
  <h1>Edit Officer</h1>
  <%= link_to "Back", admin_officer_path(officer), class: "btn btn-secondary" %>
</div>

<div class="form-card">
  <%= form_with model: [:admin, officer], local: true do |f| %>
    <% if officer.errors.any? %>
      <div class="error-box">
        <strong><%= pluralize(officer.errors.count, "error") %> prohibited this officer from being saved:</strong>
        <ul>
          <% officer.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
      <div>
        <%= f.label :badge_number, "Badge Number" %>
        <%= f.text_field :badge_number %>
      </div>
      <div>
        <%= f.label :rank %>
        <%= f.select :rank, Officer::RANKS.map { |r| [r, r] }, { include_blank: "Select Rank" } %>
      </div>
      <div>
        <%= f.label :first_name, "First Name" %>
        <%= f.text_field :first_name %>
      </div>
      <div>
        <%= f.label :last_name, "Last Name" %>
        <%= f.text_field :last_name %>
      </div>
    </div>

    <div style="margin-top:20px;">
      <%= f.label :assignments %>
      <%= f.text_area :assignments, rows: 3 %>
    </div>

    <div style="margin-top:20px;">
      <label style="display:block;font-weight:600;margin-bottom:8px;">Units</label>
      <div style="display:flex;flex-wrap:wrap;gap:12px;">
        <% Unit.order(:name).each do |unit| %>
          <label style="display:flex;align-items:center;gap:6px;font-weight:400;cursor:pointer;">
            <%= f.check_box :unit_ids, { multiple: true, checked: officer.unit_ids.include?(unit.id) }, unit.id, false %>
            <%= unit.name %>
          </label>
        <% end %>
      </div>
    </div>

    <div style="margin-top:28px;display:flex;gap:10px;">
      <%= f.submit "Update Officer", class: "btn btn-primary" %>
      <%= link_to "Cancel", admin_officer_path(officer), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>