<% content_for :title, "News Posts" %>
<div class="page-header">
  <h1>Department News</h1>
  <%= link_to "+ New Post", new_admin_news_post_path, class: "btn btn-primary" %>
</div>
<div class="table-card">
  <table class="rms-table">
    <thead><tr><th>Title</th><th>Author</th><th>Status</th><th>Published</th><th class="col-actions"></th></tr></thead>
    <tbody>
      <% @posts.each do |post| %>
        <tr>
          <td><%= post.title %></td>
          <td><%= post.author_name.presence || "—" %></td>
          <td><span class="badge <%= post.published? ? 'badge-green' : 'badge-gray' %>"><%= post.status %></span></td>
          <td style="font-size:12px;color:#8898AA;"><%= post.published_at&.strftime("%m/%d/%Y") || "—" %></td>
          <td class="col-actions">
            <%= link_to "Edit", edit_admin_news_post_path(post), class: "btn btn-secondary btn-sm" %>
            <%= button_to "Delete", admin_news_post_path(post), method: :delete, class: "btn btn-danger btn-sm", data: { turbo_confirm: "Delete this post?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
