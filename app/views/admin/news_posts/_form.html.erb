<%= form_with model: [:admin, post], class: "detail-card" do |f| %>
  <% if post.errors.any? %>
    <div class="flash flash-alert"><%= post.errors.full_messages.join(", ") %></div>
  <% end %>
  <div class="detail-card-header"><h2><%= post.new_record? ? "New Post" : "Edit Post" %></h2></div>
  <div style="padding:20px;display:flex;flex-direction:column;gap:16px;">
    <div>
      <%= f.label :title, class: "form-label" %>
      <%= f.text_field :title, class: "form-control" %>
    </div>
    <div>
      <%= f.label :author_name, "Author Name", class: "form-label" %>
      <%= f.text_field :author_name, class: "form-control" %>
    </div>
    <div>
      <%= f.label :body, "Content", class: "form-label" %>
      <%= f.text_area :body, rows: 14, class: "form-control" %>
    </div>
    <div>
      <%= f.label :status, class: "form-label" %>
      <%= f.select :status, NewsPost::STATUSES, {}, class: "form-select" %>
    </div>
    <div>
      <%= f.submit post.new_record? ? "Create Post" : "Update Post", class: "btn btn-primary" %>
      <%= link_to "Cancel", admin_news_posts_path, class: "btn btn-secondary" %>
    </div>
  </div>
<% end %>
