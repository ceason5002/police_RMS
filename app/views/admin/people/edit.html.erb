<div class="page-header">
  <h1>Edit Person</h1>
  <%= link_to "Back", admin_person_path(@person), class: "btn btn-secondary" %>
</div>

<div class="form-card">
  <%= form_with model: [:admin, @person], local: true do |f| %>
    <% if @person.errors.any? %>
      <div class="error-box">
        <strong><%= pluralize(@person.errors.count, "error") %> prohibited this from being saved:</strong>
        <ul>
          <% @person.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
      <div>
        <%= f.label :first_name, "First Name" %>
        <%= f.text_field :first_name %>
      </div>
      <div>
        <%= f.label :last_name, "Last Name" %>
        <%= f.text_field :last_name %>
      </div>
      <div>
        <%= f.label :date_of_birth, "Date of Birth" %>
        <%= f.date_field :date_of_birth %>
      </div>
      <div>
        <%= f.label :street_address, "Street Address" %>
        <%= f.text_field :street_address %>
      </div>
      <div>
        <%= f.label :city %>
        <%= f.text_field :city %>
      </div>
      <div>
        <%= f.label :state %>
        <%= f.text_field :state, maxlength: 2, placeholder: "e.g. CA" %>
      </div>
      <div>
        <%= f.label :zip_code, "ZIP Code" %>
        <%= f.text_field :zip_code %>
      </div>
    </div>

    <div style="margin-top:20px;">
      <%= f.label :notes, "Notes / History" %>
      <%= f.text_area :notes, rows: 5, placeholder: "Prior offenses, known associates, notes…" %>
    </div>

    <div style="margin-top:28px;display:flex;gap:10px;">
      <%= f.submit "Update Person", class: "btn btn-primary" %>
      <%= link_to "Cancel", admin_person_path(@person), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>