<% content_for :title, "Vehicle" %>
<div class="page-header">
  <h1>Vehicle</h1>
  <div style="display:flex;gap:10px;">
    <%= link_to "Edit", edit_vehicle_path(@vehicle), class: "btn btn-secondary" %>
    <%= button_to "Delete", @vehicle, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Are you sure?" } } %>
  </div>
</div>
<%= render @vehicle %>
<%= link_to "← Back", vehicles_path, class: "btn btn-secondary", style: "margin-top: 16px;" %>
