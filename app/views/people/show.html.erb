<% content_for :title, "Person" %>
<div class="page-header">
  <h1>Person</h1>
  <div style="display:flex;gap:10px;">
    <%= link_to "Edit", edit_person_path(@person), class: "btn btn-secondary" %>
    <%= button_to "Delete", @person, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Are you sure?" } } %>
  </div>
</div>
<%= render @person %>
<%= link_to "← Back", people_path, class: "btn btn-secondary", style: "margin-top: 16px;" %>
