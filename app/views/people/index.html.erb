<% content_for :title, "Persons" %>

<div class="page-header">
  <h1>Persons</h1>
  <%= link_to "New Person", new_person_path, class: "btn btn-primary" %>
</div>

<div class="table-card" style="margin-bottom:16px;padding:16px 20px;">
  <%= form_with url: people_path, method: :get, local: true, style: "display:flex;align-items:center;gap:12px;flex-wrap:wrap;" do |f| %>
    <%= f.text_field :name, value: params[:name], placeholder: "Name",
          style: "font-size:13px;padding:6px 10px;border:1px solid #D1D5DB;border-radius:6px;" %>
    <%= f.text_field :location, value: params[:location], placeholder: "Location (address, city, state, ZIP)",
          style: "font-size:13px;padding:6px 10px;border:1px solid #D1D5DB;border-radius:6px;min-width:220px;" %>
    <div style="display:flex;align-items:center;gap:6px;">
      <label style="font-size:13px;font-weight:500;">Date of Birth</label>
      <%= f.date_field :date_of_birth, value: params[:date_of_birth],
            style: "font-size:13px;padding:6px 10px;border:1px solid #D1D5DB;border-radius:6px;" %>
    </div>
    <%= f.submit "Filter", class: "btn btn-primary btn-sm" %>
    <%= link_to "Clear", people_path, class: "btn btn-secondary btn-sm" %>
  <% end %>
</div>

<div class="table-card">
  <table class="rms-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Date of Birth</th>
        <th>City / State</th>
        <th>Arrests</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if @people.empty? %>
        <tr><td colspan="5"><div class="empty-state"><p><%= params.slice(:name, :location, :date_of_birth).values.any?(&:present?) ? "No persons match your filters." : "No persons on record." %></p></div></td></tr>
      <% else %>
        <% @people.each do |person| %>
          <tr>
            <td class="col-primary"><%= person.full_name %></td>
            <td><%= person.date_of_birth&.strftime("%m/%d/%Y") %></td>
            <td><%= [person.city, person.state].compact_blank.join(", ") %></td>
            <td><%= person.arrests.count %></td>
            <td class="col-actions">
              <%= link_to "View", person, class: "btn btn-secondary btn-sm" %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
