<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Police RMS" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css">
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav class="rms-nav">
      <%= link_to "Police RMS", root_path, class: "rms-nav-brand" %>
      <div class="rms-nav-links">
        <%= link_to "Incidents", incidents_path %>
        <%= link_to "Officers",  officers_path %>
        <%= link_to "Arrests",   arrests_path %>
        <%= link_to "Persons",   people_path %>
        <%= link_to "Vehicles",  vehicles_path %>
        <%= link_to "Evidence",  evidences_path %>
      </div>
      <div style="margin-left:auto;display:flex;gap:8px;align-items:center;">
        <%= link_to "Community", community_root_path, style: "color:rgba(255,255,255,0.7);text-decoration:none;font-size:13px;font-weight:500;padding:5px 12px;border:1px solid rgba(255,255,255,0.2);border-radius:5px;" %>
        <% if current_user&.cad_access? %>
          <%= link_to "CAD", cad_root_path, style: "color:rgba(255,255,255,0.7);text-decoration:none;font-size:13px;font-weight:500;padding:5px 12px;border:1px solid rgba(255,255,255,0.2);border-radius:5px;" %>
        <% end %>
        <% if current_user&.admin? %>
          <%= link_to "Admin", admin_root_path, style: "color:rgba(255,255,255,0.7);text-decoration:none;font-size:13px;font-weight:500;padding:5px 12px;border:1px solid rgba(255,255,255,0.2);border-radius:5px;" %>
        <% end %>
        <%= link_to "Sign Out", destroy_user_session_path, data: { turbo_method: :delete }, style: "color:rgba(255,255,255,0.5);text-decoration:none;font-size:12px;" %>
      </div>
    </nav>
    <div class="page-container">
      <% if notice.present? %>
        <div class="flash flash-notice"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="flash flash-alert"><%= alert %></div>
      <% end %>
      <%= yield %>
    </div>
  </body>
</html>
