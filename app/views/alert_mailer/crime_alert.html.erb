<!DOCTYPE html>
<html>
<body style="font-family:Inter,sans-serif;background:#F8FAFC;padding:40px 20px;">
  <div style="max-width:560px;margin:0 auto;background:#fff;border-radius:10px;padding:32px;border:1px solid #E2E8F0;">
    <div style="background:#FEF2F2;border-left:4px solid #DF1B41;padding:12px 16px;border-radius:4px;margin-bottom:20px;">
      <strong style="color:#DF1B41;">Crime Alert — <%= @incident.incident_type %></strong>
    </div>
    <h2 style="color:#0F172A;margin-top:0;"><%= @incident.incident_type %> in <%= @incident.city %>, <%= @incident.state %></h2>
    <table style="width:100%;border-collapse:collapse;font-size:14px;">
      <tr><td style="padding:8px 0;color:#64748B;width:130px;">Type</td><td><%= @incident.incident_type %></td></tr>
      <tr><td style="padding:8px 0;color:#64748B;">Area</td><td><%= @incident.city %>, <%= @incident.state %> <%= @incident.zip_code %></td></tr>
      <tr><td style="padding:8px 0;color:#64748B;">Status</td><td><%= @incident.status %></td></tr>
      <tr><td style="padding:8px 0;color:#64748B;">Date</td><td><%= @incident.occurred_at.strftime("%B %-d, %Y") %></td></tr>
    </table>
    <p style="font-size:13px;color:#64748B;margin-top:20px;">This is an automated alert. No victim or officer information is included to protect privacy.</p>
    <hr style="border:none;border-top:1px solid #E2E8F0;margin:24px 0;">
    <p style="font-size:12px;color:#94A3B8;">
      You are receiving this because you subscribed to crime alerts for ZIP code <strong><%= @subscription.zip_code %></strong>.
      <%= link_to "Unsubscribe", @unsubscribe_url %>.
    </p>
  </div>
</body>
</html>
