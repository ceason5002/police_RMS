<% content_for :title, "Evidence" %>

<div class="page-header">
  <h1>Evidence</h1>
  <%= link_to "New Evidence", new_evidence_path, class: "btn btn-primary" %>
</div>

<div class="table-card" style="margin-bottom:16px;padding:16px 20px;">
  <%= form_with url: evidences_path, method: :get, local: true, style: "display:flex;align-items:center;gap:12px;flex-wrap:wrap;" do |f| %>
    <%= f.text_field :evidence_number, value: params[:evidence_number], placeholder: "Evidence #",
          style: "font-size:13px;padding:6px 10px;border:1px solid #D1D5DB;border-radius:6px;" %>
    <%= f.select :status,
          Evidence::STATUSES.map { |s| [s, s] },
          { selected: params[:status], include_blank: "All Statuses" },
          class: "btn btn-secondary btn-sm", style: "font-weight:400;" %>
    <%= f.text_field :location_stored, value: params[:location_stored], placeholder: "Location stored",
          style: "font-size:13px;padding:6px 10px;border:1px solid #D1D5DB;border-radius:6px;min-width:180px;" %>
    <div style="display:flex;align-items:center;gap:6px;">
      <label style="font-size:13px;font-weight:500;">Collected</label>
      <%= f.date_field :collected_date, value: params[:collected_date],
            style: "font-size:13px;padding:6px 10px;border:1px solid #D1D5DB;border-radius:6px;" %>
    </div>
    <%= f.submit "Filter", class: "btn btn-primary btn-sm" %>
    <%= link_to "Clear", evidences_path, class: "btn btn-secondary btn-sm" %>
  <% end %>
</div>

<div class="table-card">
  <table class="rms-table">
    <thead>
      <tr>
        <th>Evidence #</th>
        <th>Description</th>
        <th>Status</th>
        <th>Incident #</th>
        <th>Collected</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if @evidences.empty? %>
        <tr><td colspan="6"><div class="empty-state"><p><%= params.slice(:evidence_number, :status, :location_stored, :collected_date).values.any?(&:present?) ? "No evidence matches your filters." : "No evidence on record." %></p></div></td></tr>
      <% else %>
        <% @evidences.each do |evidence| %>
          <tr>
            <td class="col-primary"><%= evidence.evidence_number %></td>
            <td><%= evidence.description&.truncate(60) %></td>
            <td>
              <%
                badge = case evidence.status
                        when "Collected"  then "badge-blue"
                        when "In Lab"     then "badge-purple"
                        when "In Storage" then "badge-gray"
                        when "Released"   then "badge-green"
                        when "Destroyed"  then "badge-red"
                        else "badge-gray"
                        end
              %>
              <span class="badge <%= badge %>"><%= evidence.status %></span>
            </td>
            <td><%= evidence.incident&.report_number %></td>
            <td><%= evidence.collected_at&.strftime("%m/%d/%Y") %></td>
            <td class="col-actions">
              <%= link_to "View", evidence, class: "btn btn-secondary btn-sm" %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
