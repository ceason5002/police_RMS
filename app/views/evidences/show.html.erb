<% content_for :title, "Evidence" %>
<div class="page-header">
  <h1>Evidence</h1>
  <div style="display:flex;gap:10px;">
    <%= link_to "Edit", edit_evidence_path(@evidence), class: "btn btn-secondary" %>
    <%= button_to "Delete", @evidence, method: :delete, class: "btn btn-danger", form: { data: { turbo_confirm: "Are you sure?" } } %>
  </div>
</div>
<%= render @evidence %>
<%= link_to "← Back", evidences_path, class: "btn btn-secondary", style: "margin-top: 16px;" %>
