<% content_for :title, "Edit #{@unit.unit_number}" %>

<div class="page-header">
  <h1>Edit Unit — <%= @unit.unit_number %></h1>
  <%= link_to "Cancel", cad_cad_unit_path(@unit), class: "btn btn-secondary" %>
</div>

<div class="form-card">
  <%= form_with model: [:cad, @unit], url: cad_cad_unit_path(@unit), method: :patch, local: true do |f| %>
    <%= render "form", unit: @unit, f: f %>
    <div style="margin-top:24px;display:flex;gap:10px;">
      <%= f.submit "Save Changes", class: "btn btn-primary" %>
      <%= link_to "Delete Unit", cad_cad_unit_path(@unit),
            data: { turbo_method: :delete, turbo_confirm: "Remove #{@unit.unit_number} from the system?" },
            class: "btn btn-danger" %>
    </div>
  <% end %>
</div>
