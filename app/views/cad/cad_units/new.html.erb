<% content_for :title, "Add Unit" %>

<div class="page-header">
  <h1>Add New Unit</h1>
  <%= link_to "Cancel", cad_cad_units_path, class: "btn btn-secondary" %>
</div>

<div class="form-card">
  <%= form_with model: [:cad, @unit], url: cad_cad_units_path, local: true do |f| %>
    <%= render "form", unit: @unit, f: f %>
    <div style="margin-top:24px;">
      <%= f.submit "Add Unit", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
