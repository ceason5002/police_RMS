<% content_for :title, "Call History" %>

<div class="page-header">
  <h1>Call History</h1>
  <%= link_to "Reports", cad_reports_path, class: "btn btn-secondary btn-sm" %>
</div>

<!-- Filters -->
<div class="table-card" style="padding:16px 20px;margin-bottom:20px;">
  <%= form_with url: call_history_cad_reports_path, method: :get, local: true do |f| %>
    <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
      <div>
        <%= f.label :from, "From", style: "display:block;font-size:12px;font-weight:500;margin-bottom:4px;" %>
        <%= f.date_field :from, value: params[:from], style: "padding:7px 10px;border:1px solid #E3E8EF;border-radius:6px;font-size:13px;" %>
      </div>
      <div>
        <%= f.label :to, "To", style: "display:block;font-size:12px;font-weight:500;margin-bottom:4px;" %>
        <%= f.date_field :to, value: params[:to], style: "padding:7px 10px;border:1px solid #E3E8EF;border-radius:6px;font-size:13px;" %>
      </div>
      <div>
        <%= f.label :status, "Status", style: "display:block;font-size:12px;font-weight:500;margin-bottom:4px;" %>
        <%= f.select :status, [["All", ""], *CadCall::STATUSES], { selected: params[:status] }, style: "padding:7px 28px 7px 10px;border:1px solid #E3E8EF;border-radius:6px;font-size:13px;" %>
      </div>
      <div>
        <%= f.label :call_type, "Type", style: "display:block;font-size:12px;font-weight:500;margin-bottom:4px;" %>
        <%= f.select :call_type, [["All Types", ""], *CadCall::CALL_TYPES], { selected: params[:call_type] }, style: "padding:7px 28px 7px 10px;border:1px solid #E3E8EF;border-radius:6px;font-size:13px;" %>
      </div>
      <div>
        <%= f.label :unit, "Unit #", style: "display:block;font-size:12px;font-weight:500;margin-bottom:4px;" %>
        <%= f.text_field :unit, value: params[:unit], placeholder: "Unit-1", style: "width:100px;padding:7px 10px;border:1px solid #E3E8EF;border-radius:6px;font-size:13px;" %>
      </div>
      <%= f.submit "Filter", class: "btn btn-secondary btn-sm" %>
      <%= link_to "Clear", call_history_cad_reports_path, class: "btn btn-secondary btn-sm" %>
    </div>
  <% end %>
</div>

<p style="font-size:12px;color:#8898AA;margin-bottom:12px;"><%= @calls.size %> records</p>

<div class="table-card">
  <% if @calls.empty? %>
    <div class="empty-state"><p>No calls found for these filters.</p></div>
  <% else %>
    <table class="rms-table">
      <thead>
        <tr>
          <th>P</th><th>Call #</th><th>Type</th><th>Location</th>
          <th>Status</th><th>Units</th><th>Received</th><th>Dispatch RT</th><th>RMS</th>
        </tr>
      </thead>
      <tbody>
        <% @calls.each do |call| %>
          <tr style="<%= priority_row_style(call.priority) %>">
            <td><%= priority_badge(call.priority) %></td>
            <td class="col-primary"><%= link_to call.call_number, cad_call_path(call) %></td>
            <td><%= call.call_type %></td>
            <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= call.location %></td>
            <td><%= call_status_badge(call.status) %></td>
            <td style="font-size:12px;color:#8898AA;"><%= call.cad_units.map(&:unit_number).join(", ").presence || "—" %></td>
            <td style="font-size:12px;color:#8898AA;"><%= call.received_at.strftime("%m/%d %H:%M") %></td>
            <td style="font-size:12px;"><%= call.response_time_minutes ? "#{call.response_time_minutes}m" : "—" %></td>
            <td>
              <% if call.incident %>
                <%= link_to "RMS", incident_path(call.incident), class: "btn btn-secondary btn-sm" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
