<% content_for :title, "BOLOs" %>

<div class="page-header">
  <h1>BOLOs — Be On the Lookout</h1>
</div>

<%= link_to "+ Issue BOLO", new_cad_bolo_path, class: "btn btn-danger", style: "margin-bottom:20px;display:inline-block;" %>

<!-- Active BOLOs -->
<% if @active_bolos.any? %>
  <div style="margin-bottom:28px;">
    <h2 style="font-size:14px;font-weight:600;color:#DF1B41;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:12px;">
      Active BOLOs (<%= @active_bolos.size %>)
    </h2>
    <% @active_bolos.each do |bolo| %>
      <div class="bolo-card">
        <div class="bolo-card-top">
          <div style="display:flex;align-items:center;gap:12px;">
            <%= bolo_status_badge(bolo) %>
            <span style="font-size:12px;color:#8898AA;"><%= bolo.created_at.strftime("%Y-%m-%d %H:%M") %></span>
            <% if bolo.expires_at %>
              <span style="font-size:12px;color:#8898AA;">Expires: <%= bolo.expires_at.strftime("%m/%d %H:%M") %></span>
            <% end %>
          </div>
          <div style="display:flex;gap:8px;">
            <%= link_to "View", cad_bolo_path(bolo), class: "btn btn-secondary btn-sm" %>
            <%= button_to "Resolve", resolve_cad_bolo_path(bolo), method: :patch, class: "btn btn-secondary btn-sm", form: { style: "display:inline;" } %>
            <%= button_to "Cancel", cancel_cad_bolo_path(bolo), method: :patch, class: "btn btn-danger btn-sm", form: { style: "display:inline;" } %>
          </div>
        </div>
        <% if bolo.subject_description.present? %>
          <div class="bolo-field">
            <span class="bolo-field-label">Subject:</span>
            <span><%= bolo.subject_description %></span>
          </div>
        <% end %>
        <% if bolo.vehicle_description.present? %>
          <div class="bolo-field">
            <span class="bolo-field-label">Vehicle:</span>
            <span><%= bolo.vehicle_description %></span>
          </div>
        <% end %>
        <% if bolo.last_known_location.present? %>
          <div class="bolo-field">
            <span class="bolo-field-label">Last Location:</span>
            <span><%= bolo.last_known_location %></span>
          </div>
        <% end %>
        <% if bolo.issuing_officer %>
          <div class="bolo-field">
            <span class="bolo-field-label">Issued By:</span>
            <span><%= bolo.issuing_officer.full_name %></span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div style="background:#FFF8E1;border:1px solid #FDD835;border-radius:8px;padding:16px 20px;margin-bottom:24px;color:#5D4037;font-size:13px;">
    No active BOLOs at this time.
  </div>
<% end %>

<!-- Past BOLOs -->
<% if @past_bolos.any? %>
  <div>
    <h2 style="font-size:13px;font-weight:600;color:#8898AA;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:12px;">Past BOLOs</h2>
    <div class="table-card">
      <table class="rms-table">
        <thead>
          <tr><th>Status</th><th>Subject</th><th>Vehicle</th><th>Issued By</th><th>Date</th><th class="col-actions"></th></tr>
        </thead>
        <tbody>
          <% @past_bolos.each do |bolo| %>
            <tr>
              <td><%= bolo_status_badge(bolo) %></td>
              <td><%= bolo.subject_description&.truncate(50) || "—" %></td>
              <td><%= bolo.vehicle_description&.truncate(40) || "—" %></td>
              <td><%= bolo.issuing_officer&.full_name || "—" %></td>
              <td style="font-size:12px;color:#8898AA;"><%= bolo.created_at.strftime("%m/%d/%Y") %></td>
              <td class="col-actions">
                <%= link_to "View", cad_bolo_path(bolo), class: "btn btn-secondary btn-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
