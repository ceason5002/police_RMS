<% content_for :title, "Edit BOLO" %>

<div class="page-header">
  <h1>Edit BOLO #<%= @bolo.id %></h1>
  <%= link_to "Cancel", cad_bolo_path(@bolo), class: "btn btn-secondary" %>
</div>

<div class="form-card">
  <%= form_with model: @bolo, url: cad_bolo_path(@bolo), method: :patch, local: true do |f| %>
    <%= render "form", bolo: @bolo, f: f %>
    <div style="margin-top:24px;display:flex;gap:10px;">
      <%= f.submit "Save Changes", class: "btn btn-primary" %>
      <%= link_to "Delete", cad_bolo_path(@bolo),
            data: { turbo_method: :delete, turbo_confirm: "Delete this BOLO?" },
            class: "btn btn-danger" %>
    </div>
  <% end %>
</div>
