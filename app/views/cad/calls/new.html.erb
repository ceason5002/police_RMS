<% content_for :title, "New Call" %>

<div class="page-header">
  <h1>New Dispatch Call</h1>
  <%= link_to "Cancel", cad_calls_path, class: "btn btn-secondary" %>
</div>

<div class="form-card">
  <%= form_with model: @call, url: cad_calls_path, local: true do |f| %>
    <%= render "form", call: @call, f: f %>
    <div style="margin-top:24px;">
      <%= f.submit "Create Call", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
