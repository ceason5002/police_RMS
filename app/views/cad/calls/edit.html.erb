<% content_for :title, "Edit #{@call.call_number}" %>

<div class="page-header">
  <h1>Edit Call — <%= @call.call_number %></h1>
  <%= link_to "Cancel", cad_call_path(@call), class: "btn btn-secondary" %>
</div>

<div class="form-card">
  <%= form_with model: @call, url: cad_call_path(@call), method: :patch, local: true do |f| %>
    <%= render "form", call: @call, f: f %>
    <div style="margin-top:24px;display:flex;gap:10px;">
      <%= f.submit "Save Changes", class: "btn btn-primary" %>
      <%= link_to "Delete Call", cad_call_path(@call), data: { turbo_method: :delete, turbo_confirm: "Delete this call permanently?" }, class: "btn btn-danger" %>
    </div>
  <% end %>
</div>
