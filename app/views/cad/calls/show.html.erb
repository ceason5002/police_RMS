<% content_for :title, @call.call_number %>

<div class="page-header">
  <div style="display:flex;align-items:center;gap:12px;">
    <%= priority_badge(@call.priority) %>
    <h1><%= @call.call_number %></h1>
    <%= call_status_badge(@call.status) %>
  </div>
  <div class="detail-actions">
    <%= link_to "All Calls", cad_calls_path, class: "btn btn-secondary btn-sm" %>
    <%= link_to "Edit", edit_cad_call_path(@call), class: "btn btn-secondary btn-sm" %>
    <% unless @call.cleared? %>
      <%= button_to "Advance Status", advance_status_cad_call_path(@call), method: :patch, class: "btn btn-primary btn-sm" %>
    <% end %>
    <% if @call.cleared? && @call.incident.nil? %>
      <%= button_to "Send to RMS", send_to_rms_cad_call_path(@call), method: :post, class: "btn btn-secondary btn-sm", data: { turbo_confirm: "Create an RMS Incident Report from this call?" } %>
    <% elsif @call.incident.present? %>
      <%= link_to "RMS Incident", incident_path(@call.incident), class: "btn btn-secondary btn-sm" %>
    <% end %>
  </div>
</div>

<!-- Workflow Timeline -->
<div class="detail-card" style="margin-bottom:20px;">
  <div class="detail-card-header"><h2>Status Workflow</h2></div>
  <div style="display:flex;padding:16px 24px;gap:0;">
    <% steps = [["Pending", @call.received_at], ["Dispatched", @call.dispatched_at], ["On Scene", @call.on_scene_at], ["Cleared", @call.cleared_at]] %>
    <% steps.each_with_index do |(step, time), i| %>
      <div style="flex:1;text-align:center;position:relative;">
        <% active = @call.status == step || time.present? %>
        <div style="width:28px;height:28px;border-radius:50%;background:<%= active ? '#635BFF' : '#E3E8EF' %>;color:<%= active ? '#fff' : '#8898AA' %>;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;margin:0 auto 6px;"><%= i + 1 %></div>
        <div style="font-size:12px;font-weight:600;color:<%= active ? '#0A2540' : '#8898AA' %>;"><%= step %></div>
        <div style="font-size:11px;color:#8898AA;margin-top:2px;"><%= time&.strftime("%H:%M") || "—" %></div>
        <% if i < steps.size - 1 %>
          <div style="position:absolute;top:14px;left:50%;right:-50%;height:2px;background:<%= time.present? ? '#635BFF' : '#E3E8EF' %>;z-index:0;"></div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">

  <!-- Call Details -->
  <div class="detail-card">
    <div class="detail-card-header"><h2>Call Information</h2></div>
    <dl class="detail-grid">
      <div class="detail-field">
        <dt>Call Type</dt>
        <dd><%= @call.call_type %></dd>
      </div>
      <div class="detail-field">
        <dt>Priority</dt>
        <dd><%= @call.priority_label %></dd>
      </div>
      <div class="detail-field">
        <dt>Caller Name</dt>
        <dd><%= @call.caller_name.presence || "—" %></dd>
      </div>
      <div class="detail-field">
        <dt>Caller Phone</dt>
        <dd><%= @call.caller_phone.presence || "—" %></dd>
      </div>
      <div class="detail-field span-full">
        <dt>Location</dt>
        <dd><%= @call.location %></dd>
      </div>
      <% if @call.description.present? %>
        <div class="detail-field span-full">
          <dt>Description</dt>
          <dd style="white-space:pre-line;"><%= @call.description %></dd>
        </div>
      <% end %>
      <div class="detail-field">
        <dt>Received</dt>
        <dd><%= @call.received_at.strftime("%Y-%m-%d %H:%M") %></dd>
      </div>
      <div class="detail-field">
        <dt>Created By</dt>
        <dd><%= @call.created_by&.display_name || "System" %></dd>
      </div>
      <% if @call.response_time_minutes %>
        <div class="detail-field">
          <dt>Dispatch Time</dt>
          <dd><%= @call.response_time_minutes %> min</dd>
        </div>
      <% end %>
      <% if @call.on_scene_time_minutes %>
        <div class="detail-field">
          <dt>Travel Time</dt>
          <dd><%= @call.on_scene_time_minutes %> min</dd>
        </div>
      <% end %>
    </dl>
  </div>

  <!-- Units Assigned -->
  <div class="detail-card">
    <div class="detail-card-header">
      <h2>Assigned Units</h2>
    </div>

    <% if @assigned_units.any? %>
      <table class="rms-table">
        <thead>
          <tr><th>Unit</th><th>Type</th><th>Officer</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% @assigned_units.each do |unit| %>
            <tr>
              <td class="col-primary"><%= unit.unit_number %></td>
              <td><%= unit.unit_type %></td>
              <td><%= unit.assigned_officer&.full_name || "—" %></td>
              <td><%= unit_status_badge(unit.status) %></td>
              <td>
                <%= button_to "Remove", remove_unit_cad_call_path(@call, cad_unit_id: unit.id),
                      method: :delete, class: "btn btn-danger btn-sm",
                      form: { style: "display:inline;" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div style="padding:20px 24px;color:#8898AA;font-size:13px;">No units assigned yet.</div>
    <% end %>

    <% unless @call.cleared? || @available_units.empty? %>
      <div style="padding:16px 24px;border-top:1px solid #F2F5F8;">
        <%= form_with url: assign_unit_cad_call_path(@call), method: :post, local: true do |f| %>
          <div style="display:flex;gap:8px;align-items:center;">
            <%= f.select :cad_unit_id,
                  @available_units.map { |u| ["#{u.unit_number} — #{u.unit_type}#{u.assigned_officer ? ' ('+u.assigned_officer.full_name+')' : ''}", u.id] },
                  {},
                  style: "flex:1;padding:7px 10px;border:1px solid #E3E8EF;border-radius:6px;font-size:13px;" %>
            <%= f.submit "Assign Unit", class: "btn btn-primary btn-sm" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

</div>

<!-- Call Log / Notes -->
<div class="detail-card" style="margin-bottom:20px;">
  <div class="detail-card-header">
    <h2>Call Log</h2>
  </div>

  <div style="padding:0 24px;">
    <% if @notes.any? %>
      <div class="call-log">
        <% @notes.each do |note| %>
          <div class="call-log-entry">
            <div class="call-log-meta">
              <span class="call-log-time"><%= note.created_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
              <span class="call-log-user"><%= note.user&.display_name || "System" %></span>
            </div>
            <div class="call-log-body"><%= note.body %></div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div style="padding:20px 0;color:#8898AA;font-size:13px;">No log entries yet.</div>
    <% end %>
  </div>

  <!-- Add Note -->
  <%= form_with url: add_note_cad_call_path(@call), method: :post, local: true do |f| %>
    <div style="padding:16px 24px;border-top:1px solid #F2F5F8;display:flex;gap:10px;align-items:flex-end;">
      <%= f.text_area :body, placeholder: "Add a note to the call log…",
            rows: 2, style: "flex:1;padding:8px 12px;border:1px solid #E3E8EF;border-radius:6px;font-size:13px;font-family:inherit;resize:vertical;" %>
      <%= f.submit "Add Note", class: "btn btn-secondary btn-sm" %>
    </div>
  <% end %>
</div>

<% if @call.incident.present? %>
  <div class="detail-card" style="margin-bottom:20px;">
    <div class="detail-card-header"><h2>Linked RMS Incident</h2></div>
    <div style="padding:16px 24px;display:flex;align-items:center;justify-content:space-between;">
      <div>
        <span class="col-primary" style="font-weight:600;color:#0A2540;font-size:15px;"><%= @call.incident.report_number %></span>
        <span style="margin-left:12px;color:#8898AA;font-size:13px;"><%= @call.incident.incident_type %> — <%= @call.incident.status %></span>
      </div>
      <%= link_to "Open in RMS", incident_path(@call.incident), class: "btn btn-secondary btn-sm" %>
    </div>
  </div>
<% end %>
