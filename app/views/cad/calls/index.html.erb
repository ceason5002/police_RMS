<% content_for :title, "All Calls" %>

<div class="page-header">
  <h1>Call History</h1>
  <%= link_to "+ New Call", new_cad_call_path, class: "btn btn-primary" %>
</div>

<!-- Filters -->
<div class="table-card" style="padding:16px 20px;margin-bottom:20px;">
  <%= form_with url: cad_calls_path, method: :get, local: true do |f| %>
    <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
      <div style="flex:1;min-width:160px;">
        <%= f.label :q, "Search", style: "display:block;font-size:12px;font-weight:500;margin-bottom:4px;" %>
        <%= f.text_field :q, value: params[:q], placeholder: "Call #, type, location…", style: "width:100%;padding:7px 10px;border:1px solid #E3E8EF;border-radius:6px;font-size:13px;" %>
      </div>
      <div>
        <%= f.label :status, "Status", style: "display:block;font-size:12px;font-weight:500;margin-bottom:4px;" %>
        <%= f.select :status, [["All", ""], *CadCall::STATUSES], { selected: params[:status] }, style: "padding:7px 28px 7px 10px;border:1px solid #E3E8EF;border-radius:6px;font-size:13px;" %>
      </div>
      <div>
        <%= f.label :priority, "Priority", style: "display:block;font-size:12px;font-weight:500;margin-bottom:4px;" %>
        <%= f.select :priority, [["All", ""], *1..5], { selected: params[:priority] }, style: "padding:7px 28px 7px 10px;border:1px solid #E3E8EF;border-radius:6px;font-size:13px;" %>
      </div>
      <div>
        <%= f.label :call_type, "Type", style: "display:block;font-size:12px;font-weight:500;margin-bottom:4px;" %>
        <%= f.select :call_type, [["All Types", ""], *CadCall::CALL_TYPES], { selected: params[:call_type] }, style: "padding:7px 28px 7px 10px;border:1px solid #E3E8EF;border-radius:6px;font-size:13px;" %>
      </div>
      <%= f.submit "Filter", class: "btn btn-secondary btn-sm" %>
      <%= link_to "Clear", cad_calls_path, class: "btn btn-secondary btn-sm" %>
    </div>
  <% end %>
</div>

<div class="table-card">
  <% if @calls.empty? %>
    <div class="empty-state"><p>No calls found.</p></div>
  <% else %>
    <table class="rms-table">
      <thead>
        <tr>
          <th>Priority</th>
          <th>Call #</th>
          <th>Type</th>
          <th>Location</th>
          <th>Status</th>
          <th>Units</th>
          <th>Received</th>
          <th>Response</th>
          <th class="col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @calls.each do |call| %>
          <tr style="<%= priority_row_style(call.priority) %>">
            <td><%= priority_badge(call.priority) %></td>
            <td class="col-primary"><%= call.call_number %></td>
            <td><%= call.call_type %></td>
            <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= call.location %></td>
            <td><%= call_status_badge(call.status) %></td>
            <td style="font-size:12px;color:#8898AA;"><%= call.cad_units.map(&:unit_number).join(", ").presence || "—" %></td>
            <td style="font-size:12px;color:#8898AA;"><%= call.received_at.strftime("%m/%d %H:%M") %></td>
            <td style="font-size:12px;color:#8898AA;">
              <% if call.response_time_minutes %>
                <%= call.response_time_minutes %> min
              <% else %>
                —
              <% end %>
            </td>
            <td class="col-actions">
              <%= link_to "View", cad_call_path(call), class: "btn btn-secondary btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
